# Copie este arquivo para .env e preencha os valores: cp .env.example .env
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=proposta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=proposta
RABBITMQ_PASSWORD=troque-esta-senha
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# --- modulo-pedido / modulo-gateway ---
# create-drop apaga o schema ao parar; use "update" para manter os dados
JPA_DDL_AUTO=update
# Origens permitidas (CORS/WebSocket) no gateway e no pedido, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200

# --- modulo-notificacao (AWS SNS) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
